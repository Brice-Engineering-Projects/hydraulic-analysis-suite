# =============================================================================
# Python
# =============================================================================

# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST

# Type stubs generated by mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/
.cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Ruff / linting
.ruff_cache/

# =============================================================================
# uv (package manager)
# =============================================================================

# uv manages its own lock file — commit uv.lock if you want reproducible installs,
# otherwise add it here. Virtual env created by uv should never be committed.
.venv/
.python-version

# uv build artifacts
uv.egg-info/

# =============================================================================
# Jupyter / Notebooks
# =============================================================================

# Checkpoints created by Jupyter when saving
.ipynb_checkpoints/

# Auto-generated notebook outputs (optional — remove this line if you want to
# commit cell outputs for documentation/sharing purposes)
# *.ipynb

# nbconvert output
*.nbconvert/

# =============================================================================
# JetBrains IDEs (DataSpell, PyCharm, IntelliJ, etc.)
# =============================================================================

.idea/
*.iml
*.iws
*.ipr

# Shelf (local VCS stash) and workspace settings are machine-specific
.idea/shelf/
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/inspectionProfiles/
.idea/statistic/

# =============================================================================
# VS Code
# =============================================================================

.vscode/
*.code-workspace

# Local history extension
.history/

# =============================================================================
# OS artifacts
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Secrets & environment
# =============================================================================

.env
.env.*
!.env.example
*.pem
*.key
secrets/

# =============================================================================
# Miscellaneous
# =============================================================================

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp
*.swo
